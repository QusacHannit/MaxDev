# =============================================================================
# MaxDev — пример переменных окружения
# =============================================================================
# Скопируйте этот файл в backend/.env и заполните своими значениями:
#   cp .env.example backend/.env
# =============================================================================

# ── База данных ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///maxdev.db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Сгенерировать ключ: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=ЗАМЕНИТЕ_НА_СЛУЧАЙНЫЙ_КЛЮЧ_32_СИМВОЛА

# Срок жизни токена в днях
JWT_EXPIRES_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── SMTP (Email) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ваш-email@gmail.com
SMTP_PASSWORD=пароль-приложения
SMTP_FROM=MaxDev <ваш-email@gmail.com>

# ── ЮKassa ───────────────────────────────────────────────────────────────────
YOOKASSA_SHOP_ID=ваш-shop-id
YOOKASSA_SECRET_KEY=ваш-secret-key
